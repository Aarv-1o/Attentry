{
  "name": "attentry",
  "version": "0.0.1",
  "description": "Stops AI coding agents from making a mess of your codebase.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "attentry": "node --import tsx src/cli/bin.ts",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "tree-kill": "1.2.2",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "vscode-languageserver": "10.1.2",
    "web-tree-sitter": "0.27.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "bin": {
    "attentry": "dist/attentry.mjs"
  }
}
