{
  "name": "attentry",
  "displayName": "Attentry: Claude Code & Codex Checker - Security, Duplicate & Dead Code",
  "description": "Claude Code and Codex checker: catches security holes and crash risks right after each edit, points the agent to helpers the repo already has, and flags duplicate and dead code. Runs locally with no AI, so a clean edit costs zero tokens.",
  "version": "0.1.4",
  "icon": "dist/icon.png",
  "galleryBanner": { "color": "#0E1116", "theme": "dark" },
  "homepage": "https://attentry.js.org",
  "publisher": "attentry",
  "license": "MIT",
  "author": {
    "name": "Aarv Singh Chauhan",
    "email": "aarvsinghchauhan@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Aarv-1o/Attentry"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "AI",
    "Linters"
  ],
  "keywords": [
    "claude",
    "claude code",
    "openai codex",
    "codex",
    "ai code review",
    "ai agent",
    "vibe coding",
    "security",
    "duplicate code",
    "dead code",
    "linter",
    "code review",
    "mcp",
    "cursor",
    "windsurf"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "attentry.toggleShow",
        "title": "Attentry: Switch between your changes and the whole repo"
      },
      {
        "command": "attentry.rescan",
        "title": "Attentry: Scan again",
        "icon": "$(refresh)"
      },
      {
        "command": "attentry.toggleHints",
        "title": "Attentry: Show or hide hints"
      },
      {
        "command": "attentry.openReport",
        "title": "Attentry: Open the full report",
        "icon": "$(preview)"
      },
      {
        "command": "attentry.copyReport",
        "title": "Attentry: Copy the report for an agent",
        "icon": "$(copy)"
      },
      {
        "command": "attentry.checkSetup",
        "title": "Attentry: Check setup"
      }
    ],
    "configuration": {
      "title": "Attentry",
      "properties": {
        "attentry.show": {
          "type": "string",
          "enum": [
            "changes",
            "all"
          ],
          "default": "changes",
          "enumDescriptions": [
            "Only what this branch or your uncommitted work added",
            "Everything in the repo"
          ],
          "description": "Which findings to show."
        },
        "attentry.hints": {
          "type": "boolean",
          "default": false,
          "description": "Also show hints: findings Attentry is less sure about."
        },
        "attentry.serverCommand": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Run your own Attentry instead of the bundled one, e.g. [\"node\", \"--import\", \"tsx\", \"/path/to/attentry/src/cli/bin.ts\", \"lsp\"]. Empty: the bundled one."
        },
        "attentry.autoScan": {
          "type": "boolean",
          "default": true,
          "description": "Check again whenever files change (your saves and an agent's edits). Off: only when you click the refresh button at the top of the Attentry panel."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "attentry",
          "title": "Attentry",
          "icon": "resources/attentry.svg"
        }
      ]
    },
    "views": {
      "attentry": [
        {
          "type": "webview",
          "id": "attentry.panel",
          "name": "Findings"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "attentry.rescan",
          "when": "view == attentry.panel",
          "group": "navigation@1"
        },
        {
          "command": "attentry.openReport",
          "when": "view == attentry.panel",
          "group": "navigation@2"
        },
        {
          "command": "attentry.copyReport",
          "when": "view == attentry.panel",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "node build.mjs && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "@types/vscode": "1.91.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "vscode-languageclient": "10.1.2"
  }
}
